# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real tokens.
#
#   cp .env.example .env
#   # then load before running your job:
#   set -a; source .env; set +a

# Required — from @BotFather (/newbot)
JOBNOTIFY_TELEGRAM_TOKEN=123456789:AA-your-bot-token-here
# Required — your chat id (see README "getUpdates" step)
JOBNOTIFY_TELEGRAM_CHAT_ID=000000000

# Optional — default label used when a job name isn't passed in code
# JOBNOTIFY_JOB_NAME=my-training-job
# Optional — set to 1 to disable all notifications (e.g. local dev)
# JOBNOTIFY_DISABLE=0

# Optional — experiment id printed in every alert (per-run label)
# JOBNOTIFY_EXPERIMENT=kd_pku_cgl
# Optional — override the auto-detected GPU description
# JOBNOTIFY_GPU=A6000 #1
# Optional — set to 0 to skip the nvidia-smi lookup
# JOBNOTIFY_GPU_QUERY=1
# Optional — set to 0 to drop the experiment/gpu/command lines (0.1.x message)
# JOBNOTIFY_CONTEXT=1
# Optional — set to 0 to skip the "job started" alert (finish alert only)
# JOBNOTIFY_NOTIFY_START=1
